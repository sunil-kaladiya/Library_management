<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="view_library_rent_form" model="ir.ui.view">
            <field name="name">Library Rent List</field>
            <field name="model">library.rent</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                          <button name="action_confirm_rent" string="Rented" type="object" class="btn-primary"/>

                          <button name="action_return" string="Returned" type="object" class="btn-primary"/>

                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="book_id"/>
                                <field name="member_id"/>
                            </group>
                            <group>
                                <field name="rent_date"/>
                                <field name="due_date"/>
                                <field name="return_date" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="view_library_rent_list" model="ir.ui.view">
            <field name="name">Library Rent List</field>
            <field name="model">library.rent</field>
            <field name="arch" type="xml">
                <list>

                    <field name="book_id"/>
                    <field name="member_id"/>
                    <field name="rent_date"/>
                    <field name="due_date"/>
                    <field name="return_date"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="view_library_rent_search" model="ir.ui.view">
            <field name="name">library.rent.search</field>
            <field name="model">library.rent</field>
            <field name="arch" type="xml">
                <search>
                    <field name="book_id"/>
                    <field name="member_id" string="Member"/>
                    <field name="state"/>

                    <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Rented" name="filter_rented" domain="[('state', '=', 'rented')]"/>
                    <filter string="Returned" name="filter_returned" domain="[('state', '=', 'returned')]"/>
                    <filter string="Overdue" name="filter_overdue" domain="[('state', '=', 'overdue')]"/>

                    <separator/>
                    <group string="Group By">
                        <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>


        <record id="action_library_rent" model="ir.actions.act_window">
            <field name="name">Library Book Rent</field>
            <field name="res_model">library.rent</field>
            <field name="view_mode">list,form,search</field>
        </record>


        <menuitem id="menu_library_rent" parent="library_management_root" name="Rents" action="action_library_rent" />
</odoo>


